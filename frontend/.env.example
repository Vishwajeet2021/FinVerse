# Auth Service REST base URL (services/auth-service). See docs/09-api-standards.md
# and docs/10-authentication-authorization.md for the contract this client implements.
VITE_AUTH_SERVICE_URL=http://localhost:8081

# Customer Service REST base URL (services/customer-service). This service may not be
# running/finished yet in local dev — src/lib/api/customers.ts and the /dashboard route
# are written to degrade gracefully when it isn't reachable.
VITE_CUSTOMER_SERVICE_URL=http://localhost:8082

# Phase 2 services (docs/19-implementation-roadmap.md) — Account, Wallet, Payment.
VITE_ACCOUNT_SERVICE_URL=http://localhost:8083
VITE_WALLET_SERVICE_URL=http://localhost:8084
VITE_PAYMENT_SERVICE_URL=http://localhost:8085
