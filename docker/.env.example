# Copy to docker/.env, or run `python scripts/gen_env.py` to generate real values.
# docker/.env is git-ignored. Docker Compose refuses to start if a required value is missing.

# Postgres superuser (used only by the postgres container itself and operators)
POSTGRES_PASSWORD=

# One least-privilege login role per service, owning only its own database (docs/22 D-S5).
# Use URL-safe characters (hex is fine): the value is embedded in a connection URL.
AUTH_DB_PASSWORD=
CUSTOMER_DB_PASSWORD=
TRANSACTION_DB_PASSWORD=
ACCOUNT_DB_PASSWORD=
WALLET_DB_PASSWORD=
PAYMENT_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=
AUDIT_DB_PASSWORD=
FRAUD_DB_PASSWORD=

# Authenticates service-to-service calls (docs/22 D-S1). At least 32 characters.
SERVICE_AUTH_KEY=

# AES-256 key for PAN encryption at rest: 32 random bytes, base64 encoded.
CUSTOMER_PAN_ENCRYPTION_KEY=

# Grafana admin login
GRAFANA_ADMIN_PASSWORD=
